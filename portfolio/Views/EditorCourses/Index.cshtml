@* Views/EditorProjects/Index.cshtml *@
@model List<portfolio.Models.Project>
@{
    ViewData["Title"] = "Manage Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold text-uppercase h3 mb-0">Projects</h1>
    <a asp-action="Create" class="btn btn-dark btn-sm rounded-0">+ Add Project</a>
</div>

<table class="table table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Course</th>
            <th>Title</th>
            <th>Year</th>
            <th style="width: 12rem;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td class="fw-bold">@p.CourseCode</td>
                <td>@p.Title</td>
                <td>@p.YearCreated</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-dark rounded-0">Edit</a>
                    <form asp-action="Delete" asp-route-id="@p.ProjectId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-0">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>