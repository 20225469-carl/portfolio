<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PORTFOLIO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-white text-dark">
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom border-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold text-uppercase" asp-controller="Viewer" asp-action="Index">PORTFOLIO</a>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-dark text-uppercase fw-semibold" asp-controller="Viewer" asp-action="Index">Viewer</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark text-uppercase fw-semibold" asp-controller="EditorCourses" asp-action="Index">Manage Courses</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark text-uppercase fw-semibold" asp-controller="EditorProjects" asp-action="Index">Manage Projects</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="badge bg-dark text-white rounded-0">EDITOR MODE</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-dark rounded-0">Sign Out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-dark rounded-0">Switch to Editor</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <div class="container pb-5">
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>